#!/bin/sh
# Runs the project's virtualenv Python: .venv/Scripts (Windows Git Bash) or .venv/bin (Linux/macOS).
# scripts/check.conf calls tools through this so the same steps work locally and in CI.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for py in "$ROOT/.venv/Scripts/python.exe" "$ROOT/.venv/bin/python"; do
  [ -x "$py" ] && exec "$py" "$@"
done
echo "python: no .venv found. Create it: py -m venv .venv (Windows) or python3 -m venv .venv (Linux)," >&2
echo "then install: ./scripts/python -m pip install -e . --group dev" >&2
exit 1
